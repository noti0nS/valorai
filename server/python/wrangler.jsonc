{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valorai-prototype",
  "main": "valorai/worker.py",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valorai-prototype",
      "database_id": "9186a9b0-dce5-442b-96ee-a3e67b4fe2b0",
      "migrations_dir": "../migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "AUTH", "class_name": "AuthCoordinator" }]
  },
  "exports": {
    "AuthCoordinator": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "ENVIRONMENT": "development",
    "EMAIL_MODE": "demo",
    "TURNSTILE_SITE_KEY": "",
    "AI_MODE": "openai_compatible",
    "AI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    "AI_MODEL": "gemini-3.5-flash-lite",
    "AI_TIER": "free_prototype"
  },
  "env": {
    "production": {
      "name": "valorai-prototype",
      "vars": {
        "ENVIRONMENT": "production",
        "EMAIL_MODE": "resend",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFrPCsARbdASrFUU",
        "AI_MODE": "openai_compatible",
        "AI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
        "AI_MODEL": "gemini-3.5-flash-lite",
        "AI_TIER": "free_prototype"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "valorai-prototype",
          "database_id": "9186a9b0-dce5-442b-96ee-a3e67b4fe2b0",
          "migrations_dir": "../migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "AUTH", "class_name": "AuthCoordinator" }]
      }
    }
  }
}
