{
  "name": "valorai-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:api": "uv run --directory server/python pywrangler d1 migrations apply valorai-prototype --local && uv run --directory server/python pywrangler dev --ip 127.0.0.1 --port 8787",
    "build": "astro build",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:test": "docker compose run --rm test",
    "deploy": "npm run build && uv run --directory server/python pywrangler d1 migrations apply valorai-prototype --remote && uv run --directory server/python pywrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "astro": "^7.4.4",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
